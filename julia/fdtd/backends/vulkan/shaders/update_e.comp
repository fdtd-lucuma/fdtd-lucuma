#version 450
// == fdtd/parallel.jl UpdateE + optional fused InjectElectricSurfaceCurrent.
// Workgroup 16×16×1 tiles the X-Y plane; Z is swept via the gz dispatch dim.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) buffer BEx { float Ex[]; };
layout(std430, binding = 1) buffer BEy { float Ey[]; };
layout(std430, binding = 2) buffer BEz { float Ez[]; };
layout(std430, binding = 3) readonly buffer BHx { float Hx[]; };
layout(std430, binding = 4) readonly buffer BHy { float Hy[]; };
layout(std430, binding = 5) readonly buffer BHz { float Hz[]; };
layout(std430, binding = 6) readonly buffer BCee { float Cee[]; };
layout(std430, binding = 7) readonly buffer BCeh { float Ceh[]; };
layout(std430, binding = 8) readonly buffer BJx { vec2 Jx[]; };
layout(std430, binding = 9) readonly buffer BJy { vec2 Jy[]; };
layout(std430, binding = 10) readonly buffer BJz { vec2 Jz[]; };
layout(std430, binding = 11) readonly buffer BW  { float omegas[]; };

layout(push_constant) uniform PC {
	ivec4 dims;   // Nx, Ny, Nz, _
	vec4  delta;  // 1/dx, 1/dy, 1/dz, _
	ivec4 s0;     // src: axis, fixed0, r1_lo0, r2_lo0
	ivec4 s1;     // src: size1, size2, nfreqs, enable
	vec4  s2;     // src: scale, tau, _, _
} pc;

void main() {
	int Nx = pc.dims.x, Ny = pc.dims.y, Nz = pc.dims.z;
	int x = int(gl_GlobalInvocationID.x);
	int y = int(gl_GlobalInvocationID.y);
	int z = int(gl_GlobalInvocationID.z);
	if (x < 1 || y < 1 || z < 1 || x > Nx - 1 || y > Ny - 1 || z > Nz - 1)
		return;

	int idx = x + Nx * (y + Ny * z);
	int mx = idx - 1;
	int my = idx - Nx;
	int mz = idx - Nx * Ny;

	float rdx = pc.delta.x, rdy = pc.delta.y, rdz = pc.delta.z;
	float cee = Cee[idx];
	float ceh = Ceh[idx];

	Ex[idx] = cee * Ex[idx] +
	          ceh * ((Hz[idx] - Hz[my]) * rdy - (Hy[idx] - Hy[mz]) * rdz);
	Ey[idx] = cee * Ey[idx] +
	          ceh * ((Hx[idx] - Hx[mz]) * rdz - (Hz[idx] - Hz[mx]) * rdx);
	Ez[idx] = cee * Ez[idx] +
	          ceh * ((Hy[idx] - Hy[mx]) * rdx - (Hx[idx] - Hx[my]) * rdy);

	if (pc.s1.w != 1) return;
	int axis = pc.s0.x, fix = pc.s0.y, r1 = pc.s0.z, r2 = pc.s0.w;
	int sz1 = pc.s1.x, sz2 = pc.s1.y, nf = pc.s1.z;
	int a0, b0;
	bool on;
	if (axis == 1)      { on = (x == fix); a0 = y - r1; b0 = z - r2; }
	else if (axis == 2) { on = (y == fix); a0 = x - r1; b0 = z - r2; }
	else                { on = (z == fix); a0 = x - r1; b0 = y - r2; }
	if (!on || a0 < 0 || a0 >= sz1 || b0 < 0 || b0 >= sz2) return;

	int slab = sz1 * sz2;
	int base = a0 + sz1 * b0;
	float tau = pc.s2.y;
	float jx = 0.0, jy = 0.0, jz = 0.0;
	for (int n = 0; n < nf; ++n) {
		float th = omegas[n] * tau;
		float cs = cos(th), sn = sin(th);
		int j = base + slab * n;
		jx += Jx[j].x * cs - Jx[j].y * sn;
		jy += Jy[j].x * cs - Jy[j].y * sn;
		jz += Jz[j].x * cs - Jz[j].y * sn;
	}
	float g = ceh * pc.s2.x;
	Ex[idx] -= g * jx;
	Ey[idx] -= g * jy;
	Ez[idx] -= g * jz;
}
