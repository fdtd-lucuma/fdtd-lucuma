pkgver() {
	cd "$srcdir/$pkgname"
	( set -o pipefail
	git describe --long 2>/dev/null | sed 's/^v-//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
	printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
	)
}

prepare() {
	cd "$srcdir/nativefiledialog-extended-git"
	git submodule update --init --recursive --force
}

build() {
	cmake -G Ninja -B build -S "$pkgname" \
		-DCMAKE_BUILD_TYPE='None' \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INTERPROCEDURAL_OPTIMIZATION=ON \
		-DCMAKE_UNITY_BUILD=ON \
		-DUSE_SYSTEM_LIBS=ON \
		-DFETCHCONTENT_FULLY_DISCONNECTED=ON \
		-DFETCHCONTENT_SOURCE_DIR_IMGUI="$srcdir/imgui-git" \
		-DFETCHCONTENT_SOURCE_DIR_IMGUI-MODULE="$srcdir/imgui-module-git" \
		-DFETCHCONTENT_SOURCE_DIR_VULKANMEMORYALLOCATOR-HPP="$srcdir/vma-hpp-git" \
		-DFETCHCONTENT_SOURCE_DIR_VULKANMEMORYALLOCATOR="$srcdir/vma-git" \
		-DFETCHCONTENT_SOURCE_DIR_VKFW="$srcdir/vkfw-git" \
		-DFETCHCONTENT_SOURCE_DIR_MAGIC_ENUM="$srcdir/magic-enum-git" \
		-DFETCHCONTENT_SOURCE_DIR_MDSPAN="$srcdir/mdspan-git" \
		-DFETCHCONTENT_SOURCE_DIR_IMGUI-GRAPHNODE="$srcdir/imgui-graphnode-git" \
		-DFETCHCONTENT_SOURCE_DIR_IMPLOT3D="$srcdir/implot3d-git" \
		-DFETCHCONTENT_SOURCE_DIR_IMPLOT="$srcdir/implot-git" \
		-DFETCHCONTENT_SOURCE_DIR_NATIVEFILEDIALOG-EXTENDED="$srcdir/nativefiledialog-extended-git" \
		-DFETCHCONTENT_SOURCE_DIR_TRACY="$srcdir/tracy-git" \
		-DCMAKE_CXX_VISIBILITY_PRESET=hidden \
		-DCMAKE_C_VISIBILITY_PRESET=hidden \

	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
